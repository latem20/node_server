# Copia este archivo como .env y ajusta los valores.

FLASK_ENV=development
SERVER_PORT=8000
SECRET_KEY=cambia-esta-clave-secreta-flask

# Clave que usará el ESP32 en el header X-API-KEY
SENSOR_API_KEY=mi_clave_secreta_123

# Usuario administrador inicial (scripts/seed_admin.py)
ADMIN_EMAIL=admin@agro.local
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Lennin Manrique

# Zona y nodo de prueba para macetas
DEFAULT_ZONE_NAME=Macetas piloto
DEFAULT_ZONE_LOCATION=Riobamba - pruebas locales
DEFAULT_NODE_CODE=nodo_maceta_01
DEFAULT_NODE_LABEL=Maceta 01

